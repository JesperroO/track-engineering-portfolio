# Keep raw or generated material out of the public presentation repository.
*.csv
*.csv.gz
*.gz
*.npz
*.xlsx
*.zip
*.mp4
*.mov
*.mkv
*.wav
*.jpg
*.jpeg
*.png
raw/
private/
work/
.DS_Store

# The curated public figures and frame exports are intentional exceptions.
!assets/
!assets/p1/
!assets/p1/*.png
!assets/p1/video_frames/
!assets/p1/video_frames/*.jpg

# Curated simulation analysis figures; full-rate telemetry stays private.
!assets/sim/
!assets/sim/*.png

# Curated vehicle-model diagnostics.
!assets/modelling/
!assets/modelling/*.png
__pycache__/
*.pyc

# Selected trackside workflow photograph.
!assets/workflow/
!assets/workflow/p1-trackside-circuit-tools.png
